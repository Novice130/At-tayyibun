{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dokploy-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ahdev/dokploy-mcp"
      ],
      "environment": {
        "DOKPLOY_URL": "https://dokploy.learnnovice.com/api",
        "DOKPLOY_API_KEY": "cptsxjFfOHxUxUhZCALSoUufcYOZDEsIOJIeDFGsmoiOSmyWDQVvJRpABkKreXmtYaqW"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": true
    },
    "memory-bank": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@allpepper/memory-bank-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    }
  }
}