# At-Tayyibun Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (Neon)
# =============================================================================
# Paste your Neon Database connection string here
DATABASE_URL=""
# Optional (API only): connection string for a schema-owning role, used solely
# by the boot-time migration and unset before the server starts. When set,
# DATABASE_URL should be a DML-only role. See docs/infra-hardening.md.
MIGRATION_DATABASE_URL=""

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# AUTHENTICATION (BetterAuth)
# =============================================================================
BETTER_AUTH_SECRET="" # Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your web app

# ---- Google Sign-In ----
# Both values come from the *Web application* OAuth client in Google Cloud
# Console (APIs & Services > Credentials).
#
# Authorised redirect URI must be exactly:
#   https://attayyibun.com/auth/callback/google
#   http://localhost:3000/auth/callback/google   (for local development)
#
# The Android app also authenticates against this SAME web client id: it passes
# it as `serverClientId` so the ID token's audience matches what the server
# verifies. Do not use the Android OAuth client id here.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google OAuth (For BetterAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (For BetterAuth)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# =============================================================================
# ENCRYPTION
# =============================================================================
# 32-byte hex key for AES-256-GCM (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=""

# =============================================================================
# EMAIL (Resend) — used for password resets, contact-request notifications, 2FA admin OTP
# =============================================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@attayyibun.com"
RESEND_FROM_NAME="At-Tayyibun"

# =============================================================================
# PHONE VERIFICATION (Firebase Phone Auth) — one verified number per account
# =============================================================================
# Firebase delivers and checks the SMS code on the client; the ID token it
# returns is verified server-side and exchanged for a better-auth session.
#
# Client half — Firebase Console -> Project settings -> Your apps -> Web app.
# These ship to the browser by design; they are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=at-tayyibun.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=at-tayyibun-e3f79
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server half — Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key".
FIREBASE_PROJECT_ID=at-tayyibun-e3f79
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@at-tayyibun-e3f79.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Dialling code assumed for numbers typed without one (E.164, e.g. +1).
# Must match the SMS region policy set in the Firebase console.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE="+1"

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# =============================================================================
# SENTRY (sentry.io) - leave the DSNs empty to disable
# API reads SENTRY_*; web client reads NEXT_PUBLIC_SENTRY_* (build time).
# SENTRY_AUTH_TOKEN (web source map upload) is a CI secret, not set here.
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_BROWSE_MAX=60
RATE_LIMIT_BROWSE_WINDOW_MS=60000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
MEMBERSHIP_ENABLED=true
