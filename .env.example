# At-Tayyibun Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (Neon)
# =============================================================================
# Paste your Neon Database connection string here
DATABASE_URL=""

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# AUTHENTICATION (BetterAuth)
# =============================================================================
BETTER_AUTH_SECRET="" # Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your web app

# Google OAuth (For BetterAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (For BetterAuth)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# =============================================================================
# ENCRYPTION
# =============================================================================
# 32-byte hex key for AES-256-GCM (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=""

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================
GCS_BUCKET_NAME="at-tayyibun-photos"
GCS_PROJECT_ID=""
# Path to service account JSON or leave empty for local dev
GOOGLE_APPLICATION_CREDENTIALS=""

# =============================================================================
# EMAIL (Resend) — used for password resets, contact-request notifications, 2FA admin OTP
# =============================================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@attayyibun.com"
RESEND_FROM_NAME="At-Tayyibun"

# =============================================================================
# PHONE VERIFICATION (Twilio Verify) — gates account activation at signup
# =============================================================================
# Auth: API Key SID + Secret (NOT the auth token). Create at Twilio Console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID=""        # AC...
TWILIO_API_KEY_SID=""        # SK...
TWILIO_API_KEY_SECRET=""     # paired secret for the API Key
TWILIO_VERIFY_SERVICE_SID="" # VA... — Twilio Console → Verify → Services

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_BROWSE_MAX=60
RATE_LIMIT_BROWSE_WINDOW_MS=60000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
MEMBERSHIP_ENABLED=true
