# ============================================================
# At-Tayyibun - Next.js Frontend (Production)
# ============================================================
# Multi-stage build optimized for pnpm monorepo

# --- Stage 1: Install dependencies ---
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate
WORKDIR /app

# Copy workspace config files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/api/prisma ./apps/api/prisma

# Install ALL dependencies (need devDeps for build)
RUN pnpm install --frozen-lockfile

# Generate Prisma client (needed by BetterAuth at build time)
RUN cd apps/api && npx prisma generate

# --- Stage 2: Build the Next.js app ---
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY . .

# Set Next.js to output standalone for Docker
ENV NEXT_TELEMETRY_DISABLED=1

# Build the web app
RUN cd apps/web && pnpm build

# Normalize Prisma client paths from pnpm's nested .pnpm/ structure
# pnpm stores packages at node_modules/.pnpm/@prisma+client@*/node_modules/...
# We copy them to a flat /prisma_client/ directory for the runner stage
RUN mkdir -p /prisma_client/.prisma /prisma_client/@prisma && \
    cp -r node_modules/.pnpm/@prisma+client*/node_modules/.prisma/* /prisma_client/.prisma/ && \
    cp -r node_modules/.pnpm/@prisma+client*/node_modules/@prisma/* /prisma_client/@prisma/

# --- Stage 3: Production runner ---
FROM node:20-alpine AS runner
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built assets
COPY --from=builder /app/apps/web/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next ./.next
COPY --from=builder /app/apps/web/node_modules ./node_modules
COPY --from=builder /app/apps/web/package.json ./package.json
COPY --from=builder /app/apps/web/next.config.js ./next.config.js

# Copy Prisma client from normalized location (needed by BetterAuth at runtime)
COPY --from=builder /prisma_client/.prisma ./node_modules/.prisma
COPY --from=builder /prisma_client/@prisma ./node_modules/@prisma

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npx", "next", "start"]
