# At-Tayyibun API Environment Variables
# Copy to .env and fill in real values (never commit .env)

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-with: openssl rand -base64 32"
JWT_EXPIRES_IN="7d"
# Must match the web app's BETTER_AUTH_SECRET (same value, both services)
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
NODE_ENV="development"
API_PORT=3001
WEB_URL="http://localhost:3000"

# 32-byte hex key for AES-256-GCM (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Google OAuth (legacy passport stack — kept until strategies are removed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@attayyibun.com
RESEND_FROM_NAME=At-Tayyibun
