# At-Tayyibun API Environment Variables
# Copy to .env and fill in real values (never commit .env)

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Optional: schema-owning role used only by the boot-time migration; unset
# before the server starts. See docs/infra-hardening.md.
MIGRATION_DATABASE_URL=""
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-with: openssl rand -base64 32"
JWT_EXPIRES_IN="7d"
# Must match the web app's BETTER_AUTH_SECRET (same value, both services)
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
NODE_ENV="development"
API_PORT=3001
WEB_URL="http://localhost:3000"

# 32-byte hex key for AES-256-GCM (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Google OAuth (legacy passport stack — kept until strategies are removed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Sign in with Apple
# APPLE_CLIENT_SECRET is generated by `pnpm --filter api apple:secret` and
# expires every 6 months — regenerate and redeploy before it lapses or all
# Apple sign-ins fail with an opaque invalid_client.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.attayyibun.web
APPLE_PRIVATE_KEY=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=com.attayyibun.attayyibun

# Moderation notification target (report emails)
ADMIN_EMAIL=admin@attayyibun.com

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@attayyibun.com
RESEND_FROM_NAME=At-Tayyibun

# Sentry (sentry.io). Leave SENTRY_DSN empty to disable the SDK.
# Read from the process environment (not .env) because src/instrument.ts runs
# before ConfigModule loads.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SAMPLE_RATE=1
