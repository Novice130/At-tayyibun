# At-Tayyibun Web Environment Variables
# Copy to .env.local and fill in real values (never commit .env.local)

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@attayyibun.com
RESEND_FROM_NAME=At-Tayyibun

# Sentry (sentry.io). Leave NEXT_PUBLIC_SENTRY_DSN empty to disable the SDK.
# NEXT_PUBLIC_* are inlined at build time (Docker build args); the server/edge
# SDK reads SENTRY_DSN / SENTRY_ENVIRONMENT first and falls back to these.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_SAMPLE_RATE=1
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_SAMPLE_RATE=
# Release = git SHA; set by CI at build time.
SENTRY_RELEASE=
# Build time only, source map upload (CI passes it as a BuildKit secret).
# Without it the build skips the upload.
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=attayyibun-web

# Google Sign-In — web OAuth client id; secret must be rotated
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (same values as the API; the secret comes from
# `pnpm --filter api apple:secret` and expires every 6 months)
APPLE_CLIENT_ID=com.attayyibun.web
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=com.attayyibun.attayyibun

# =============================================================================
# PHONE VERIFICATION (Firebase Phone Auth) — one verified number per account
# =============================================================================
# Firebase delivers and checks the SMS code on the client; the ID token it
# returns is verified server-side and exchanged for a better-auth session.
#
# Client half — Firebase Console -> Project settings -> Your apps -> Web app.
# These ship to the browser by design; they are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=at-tayyibun.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=at-tayyibun-e3f79
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server half — Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key".
FIREBASE_PROJECT_ID=at-tayyibun-e3f79
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@at-tayyibun-e3f79.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Dialling code assumed for numbers typed without one (E.164, e.g. +1).
# Must match the SMS region policy set in the Firebase console.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE="+1"
