// Dev app (flavor `dev`): installs next to the real app and talks to
// https://staging.attayyibun.com. Overrides prod.xcconfig.
PRODUCT_BUNDLE_IDENTIFIER = com.attayyibun.attayyibun.dev
APP_DISPLAY_NAME = At-Tayyibun Dev
// iOS OAuth client for com.attayyibun.attayyibun.dev. Google ties iOS clients
// to one bundle ID, so the prod client can't be reused. Fill both in once the
// client exists (README "Dev app"); until then Google sign-in fails in the dev
// app only.
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = com.attayyibun.attayyibun.dev.google-not-configured
