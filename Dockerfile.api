# ============================================================
# At-Tayyibun - NestJS API (Production)
# Single-install, serial stages. No parallel pnpm thrash.
# NOTE: pnpm 9 `deploy` does not support hoisted linker, so we
# ship the deps node_modules directly. Larger image, reliable.
# ============================================================

# --- Stage 1: Install deps once (cached) ---
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json

# Throttle concurrency so small VPS network doesn't stall.
RUN pnpm config set network-concurrency 4 \
 && pnpm install --frozen-lockfile --prefer-offline

# --- Stage 2: Build NestJS (reuse deps, no second install) ---
FROM deps AS builder
WORKDIR /app
COPY . .
RUN cd apps/api && pnpm build

# --- Stage 3: Production-only deps (drops devDeps + web workspace) ---
# Reuses the deps cache, then prunes everything but the api workspace's
# production deps. Cuts node_modules from ~1.5 GB → a few hundred MB so the
# runner copy doesn't blow out a small VPS disk.
FROM deps AS prod-deps
WORKDIR /app
RUN pnpm install --filter @at-tayyibun/api --prod --frozen-lockfile --prefer-offline \
 && pnpm store prune \
 && rm -rf /root/.local/share/pnpm /root/.cache

# --- Stage 4: Runner ---
FROM node:20-alpine AS runner
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nestjs

COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json
# The migration SQL and journal are read at runtime by dist/src/migrate.js,
# which resolves them at ../../drizzle relative to itself.
COPY --from=builder /app/apps/api/drizzle ./drizzle
COPY --from=prod-deps /app/node_modules ./node_modules

USER nestjs

EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Migrations run before the server, in their own process, and a failure stops
# the container rather than letting a new build start against an old schema.
# The migrate script refuses to run at all if drizzle's ledger is missing —
# see apps/api/scripts/bootstrap-migrations.sql.
CMD ["sh", "-c", "node dist/src/migrate && exec node dist/src/main"]
