# ======================================================
# Build context exclusions — keep context small + clean
# ======================================================

# Deps (must install fresh in image)
node_modules
**/node_modules

# Build artifacts
dist
**/dist
.next
**/.next
build
**/build
coverage
**/coverage

# VCS + IDE
.git
.gitignore
.vscode
.idea
*.swp

# Env / secrets (never ship to image)
.env
.env.*
!.env.example

# Logs / temp
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
temp_*/
tmp
.cache

# OS junk
.DS_Store
Thumbs.db

# Tests + docs (not needed at runtime)
test-*.ts
*.test.ts
*.spec.ts
*.bak

# Screenshots / binaries (root only — keep apps/web/public assets)
/*.png
/*.jpg
/*.jpeg
/*.gif

# Misc tracked artifacts not needed in image
graphify-out
.playwright-mcp
docs

# Dokploy / CI
.github
.dockerignore
docker-compose.yml
README.md
