# ======================================================
# Build context exclusions — keep context small + clean
# ======================================================

# Deps (must install fresh in image)
node_modules
**/node_modules

# Build artifacts
dist
**/dist
.next
**/.next
build
**/build
coverage
**/coverage

# VCS + IDE
.git
**/.git
.gitignore
.vscode
.idea
*.swp

# Env / secrets (never ship to image)
# A bare pattern matches the build-context root only, hence the **/ forms.
.env
.env.*
**/.env
**/.env.*
**/.env*
*.p8
**/*.p8
*.pem
**/*.pem
*.key
**/*.key
*.jks
**/*.jks
key.properties
**/key.properties
service-account.json
**/service-account.json
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
**/*firebase*admin*.json
opencode-mcp-export.json
**/opencode-mcp-export.json

# Logs / temp
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
temp_*/
tmp
.cache

# OS junk
.DS_Store
Thumbs.db

# Tests + docs (not needed at runtime)
test-*.ts
*.test.ts
*.spec.ts
*.bak

# Screenshots / binaries (root only — keep apps/web/public assets)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.mp4

# Misc tracked artifacts not needed in image
graphify-out
.playwright-mcp
docs
video
loadtest
memory-bank
**/docs
**/*.p12
**/*serviceaccount*.json
**/*service-account*.json
**/google-services.json
**/GoogleService-Info.plist
diagnostics
apps/mobile

# Dokploy / CI
.github
.dockerignore
docker-compose.yml
README.md
